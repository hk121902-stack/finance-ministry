# Public source allowlist. Local research and financial datasets stay on this machine.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/android-app/
!/.github/
!/docs/
!/tools/
/docs/*
!/docs/PRIVACY.md
!/docs/RELEASING.md
!/docs/ROADMAP.md
!/docs/THIRD_PARTY_NOTICES.md
/tools/*
!/tools/verify_public_tree.py
!/tools/publish-alpha.ps1

# Never commit generated output, local configuration, credentials, or runtime data.
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/local.properties
**/node_modules/
**/__pycache__/
*.iml
*.apk
*.aab
*.apks
*.jks
*.keystore
*.p12
*.pfx
*.hprof
*.log
*.db
*.db-*
*.sqlite*
*.csv
*.xlsx
*.jsonl
.env
.env.*
**/secrets.properties
**/signing.properties
**/.DS_Store
**/Thumbs.db
